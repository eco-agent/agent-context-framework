{
  "name": "@agent-context/objective-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm build && tsc -p tsconfig.test.json --noEmit && node --import tsx --test test/*.test.ts",
    "test:postgres": "pnpm build && tsc -p tsconfig.test.json --noEmit && node --import tsx --test test-postgres/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-context/objective-kernel": "workspace:*",
    "@effect/sql": "0.52.0",
    "@effect/sql-pg": "0.53.0",
    "effect": "3.22.0",
    "pg-boss": "12.26.3"
  },
  "devDependencies": {
    "@agent-context/objective-test-fixtures": "workspace:*",
    "@types/node": "24.13.3",
    "tsx": "4.22.4",
    "typescript": "7.0.2"
  },
  "agentContext": {
    "category": "tooling",
    "owner": "platform"
  }
}
