{
  "name": "@agent-context/codex-frontend-workflows",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./preflight": {
      "types": "./dist/src/preflight.d.ts",
      "import": "./dist/src/preflight.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "preflight": "pnpm build && node dist/src/preflight-cli.js",
    "test": "pnpm build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@agent-context/codex-workflow-runtime": "workspace:*"
  },
  "devDependencies": {
    "@openai/codex-sdk": "0.145.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "agentContext": {
    "category": "tooling",
    "owner": "framework"
  }
}
