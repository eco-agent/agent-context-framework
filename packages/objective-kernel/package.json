    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "json-canonicalize": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.22.4",
    "typescript": "7.0.2"
