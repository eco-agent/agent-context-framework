    "<div class=\"mask-no-repeat mask-[url(/img/circle.png)] mask-size-[50px_50px] bg-[url(/img/mountains.jpg)] ...\"></div>",
    "<div class=\"mask-repeat md:mask-repeat-x ...\">\n  <!-- ... -->\n</div>"
  ],
