    "<div class=\"grid h-56 grid-cols-3 place-items-center gap-4 ...\">\n  <div>01</div>\n  <div>02</div>\n  <div>03</div>\n  <div>04</div>\n  <div>05</div>\n  <div>06</div>\n</div>",
    "<div class=\"grid h-56 grid-cols-3 place-items-stretch gap-4 ...\">\n  <div>01</div>\n  <div>02</div>\n  <div>03</div>\n  <div>04</div>\n  <div>05</div>\n  <div>06</div>\n</div>",
    "<div class=\"grid place-items-start md:place-items-center ...\">\n  <!-- ... -->\n</div>"
  ],
